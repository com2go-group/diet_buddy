# Copy to .env (never commit .env). Only EXPO_PUBLIC_* values reach the app bundle, so only
# public values belong here. Server secrets (service role key, LLM and USDA API keys) are set
# with `npx supabase secrets set` and read by Edge Functions only.

# Local stack: printed by `npx supabase start` (API URL and anon key).
# Hosted: Supabase dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Auth options (see docs/auth.md).
# Phone sign-up with SMS codes; requires an SMS provider on the Supabase project.
EXPO_PUBLIC_AUTH_PHONE_ENABLED=false
# Google Sign-In (Google Cloud OAuth clients). The web client ID is what Supabase verifies.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# RevenueCat public SDK keys (docs/setup/revenuecat.md). Purchases work only in iOS/Android builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob (docs/setup/admob.md). App IDs are build-time; unit IDs fall back to Google test ads.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=

# Legal pages linked at sign-up (must be live before store submission).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
# Store pages for the "Time to update" screen (dashboard → Settings → minimum app version)
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
