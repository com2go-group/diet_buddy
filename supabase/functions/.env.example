# Secrets for `npx supabase functions serve` (copy to supabase/functions/.env, never commit it).
# On the hosted project set them with `npx supabase secrets set KEY=value`.
USDA_API_KEY=
ANTHROPIC_API_KEY=
# Only if your Anthropic organisation requires a workspace on every request and the key isn't
# scoped to one ("not scoped to a workspace" error): the workspace ID, wrkspc_...
ANTHROPIC_WORKSPACE_ID=
# Optional; defaults to claude-sonnet-5. claude-haiku-4-5-20251001 is cheaper for chat.
COACH_MODEL=
# Optional; the model for free users' coach, meal plans and food photos (default claude-haiku-4-5).
# Premium keeps COACH_MODEL / MEAL_PLAN_MODEL / VISION_MODEL. Limits and budgets are in app_config.
FREE_AI_MODEL=
# Optional; the model food-search uses to turn non-English searches into English (default claude-haiku-4-5-20251001).
SEARCH_TRANSLATE_MODEL=
# Shared secret RevenueCat sends in the Authorization header, e.g. "Bearer <random>".
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat secret API key (sk_…, Project settings → API keys): sync-premium confirms a purchase at once
REVENUECAT_SECRET_KEY=
# Bearer secret pg_cron sends to push-dispatch.
CRON_SECRET=
# Optional Expo access token (enhanced push security).
EXPO_ACCESS_TOKEN=
