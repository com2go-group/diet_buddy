# Secrets for `npx supabase functions serve` (copy to supabase/functions/.env, never commit it).
# On the hosted project set them with `npx supabase secrets set KEY=value`.
USDA_API_KEY=
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5. claude-haiku-4-5-20251001 is cheaper for chat.
COACH_MODEL=
# Shared secret RevenueCat sends in the Authorization header, e.g. "Bearer <random>".
REVENUECAT_WEBHOOK_AUTH=
# Bearer secret pg_cron sends to push-dispatch.
CRON_SECRET=
# Optional Expo access token (enhanced push security).
EXPO_ACCESS_TOKEN=
